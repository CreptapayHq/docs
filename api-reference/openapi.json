{
  "openapi": "3.0.0",
  "info": {
    "title": "CreptaPay API",
    "version": "1.0.0",
    "description": "External API endpoints for CreptaPay payment processing."
  },
  "servers": [
    {
      "url": "https://api.creptapay.com/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "Customer": {
        "type": "object",
        "required": [
          "id",
          "first_name",
          "last_name",
          "email"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "60d0fe4f5311236168a109c9"
          },
          "first_name": {
            "type": "string",
            "example": "John"
          },
          "last_name": {
            "type": "string",
            "example": "Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john.doe@example.com"
          },
          "phone": {
            "type": "string",
            "example": "+1234567890"
          }
        }
      },
      "CustomerList": {
        "type": "object",
        "required": [
          "data",
          "total"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Customer"
            }
          },
          "total": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "LineItem": {
        "type": "object",
        "required": [
          "name",
          "amount",
          "quantity"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Item Name"
          },
          "amount": {
            "type": "number",
            "example": 10.5
          },
          "quantity": {
            "type": "integer",
            "example": 2
          }
        }
      },
      "Payment": {
        "type": "object",
        "required": [
          "id",
          "reference",
          "customer",
          "currency",
          "amount",
          "address",
          "fees",
          "total",
          "description",
          "line_items",
          "status",
          "type",
          "business",
          "allowed_currencies",
          "expires_at",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "60d0fe4f5311236168a109ca"
          },
          "reference": {
            "type": "string",
            "example": "CP-A1B2C3D4E5"
          },
          "customer": {
            "$ref": "#/components/schemas/Customer"
          },
          "currency": {
            "type": "string",
            "example": "USD"
          },
          "amount": {
            "type": "number",
            "example": 21.0
          },
          "address": {
            "type": "string",
            "example": "0x1234567890123456789012345678901234567890"
          },
          "fees": {
            "type": "number",
            "example": 0.21
          },
          "total": {
            "type": "number",
            "example": 21.0
          },
          "description": {
            "type": "string",
            "example": "Invoice Payment"
          },
          "line_items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LineItem"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "paid",
              "expired"
            ],
            "example": "pending"
          },
          "type": {
            "type": "string",
            "example": "api"
          },
          "business": {
            "type": "string",
            "example": "60d0fe4f5311236168a109c8"
          },
          "allowed_currencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": []
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-24T14:40:15Z"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-24T14:08:52Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-24T14:08:52Z"
          },
          "transactionHash": {
            "type": "string",
            "example": "0xabcdef1234567890..."
          }
        }
      },
      "PaymentList": {
        "type": "object",
        "required": [
          "data",
          "has_more",
          "total"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Payment"
            }
          },
          "has_more": {
            "type": "boolean",
            "example": false
          },
          "total": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "DeleteConfirmation": {
        "type": "object",
        "required": [
          "success",
          "message"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Customer profile successfully deleted"
          }
        }
      }
    }
  },
  "paths": {
    "/payment": {
      "post": {
        "summary": "Create Payment",
        "description": "Initialize a new checkout payment transaction. Requires a public key starting with pk_.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "customer",
                  "items"
                ],
                "properties": {
                  "customer": {
                    "type": "object",
                    "required": [
                      "first_name",
                      "last_name",
                      "email"
                    ],
                    "properties": {
                      "first_name": {
                        "type": "string"
                      },
                      "last_name": {
                        "type": "string"
                      },
                      "email": {
                        "type": "string"
                      },
                      "phone": {
                        "type": "string"
                      }
                    }
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "amount",
                        "quantity"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "amount": {
                          "type": "number"
                        },
                        "quantity": {
                          "type": "integer"
                        }
                      }
                    }
                  },
                  "description": {
                    "type": "string"
                  },
                  "expires_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              },
              "example": {
                "customer": {
                  "first_name": "John",
                  "last_name": "Doe",
                  "email": "john.doe@example.com",
                  "phone": "+1234567890"
                },
                "items": [
                  {
                    "name": "Item Name",
                    "amount": 10.5,
                    "quantity": 2
                  }
                ],
                "description": "Invoice Payment",
                "expires_at": "2026-07-24T14:40:15Z"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List Payments",
        "description": "Retrieve list of payments. Requires secret API key starting with sk_.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved payments",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentList"
                }
              }
            }
          }
        }
      }
    },
    "/payment/{id}": {
      "get": {
        "summary": "Get Payment Detail",
        "description": "Retrieve specific transaction details. Requires secret API key starting with sk_.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved payment details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          }
        }
      }
    },
    "/payment/reference/{reference}": {
      "get": {
        "summary": "Get Payment by Reference",
        "description": "Retrieve payment status and information by transaction reference. Requires public key starting with pk_.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved payment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          }
        }
      }
    },
    "/customer": {
      "get": {
        "summary": "Fetch Customers",
        "description": "Retrieve all customers for the authenticated business. Requires secret key starting with sk_.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully fetched customers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerList"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Customer",
        "description": "Create a new customer profile. Requires secret key starting with sk_.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "first_name",
                  "last_name"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "first_name": {
                    "type": "string"
                  },
                  "last_name": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "email": "john.doe@example.com",
                "first_name": "John",
                "last_name": "Doe",
                "phone": "+1234567890"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully created customer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            }
          }
        }
      }
    },
    "/customer/{id}": {
      "get": {
        "summary": "Fetch Customer details",
        "description": "Retrieve specific customer information by ID. Requires secret key starting with sk_.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully fetched customer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update Customer details",
        "description": "Edit details of an existing customer by ID. Requires secret key starting with sk_.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "first_name": {
                    "type": "string"
                  },
                  "last_name": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "email": "john.doe@example.com",
                "first_name": "John",
                "last_name": "Doe",
                "phone": "+1234567890"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully updated customer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete Customer",
        "description": "Remove a customer profile by ID. Requires secret key starting with sk_.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully deleted customer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteConfirmation"
                }
              }
            }
          }
        }
      }
    }
  }
}