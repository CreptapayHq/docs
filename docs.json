{
    "$schema": "https://mintlify.com/docs.json",
    "theme": "mint",
    "name": "Mint Starter Kit",
    "colors": {
        "primary": "#09CCDD",
        "light": "#0CDDFF",
        "dark": "#008FA1"
    },
    "favicon": "/favicon.svg",
    "navigation": {
        "tabs": [
            {
                "tab": "Guides",
                "groups": [
                    {
                        "group": "Getting started",
                        "pages": ["index", "quickstart", "development"]
                    },
                    {
                        "group": "Customization",
                        "pages": [
                            "essentials/settings",
                            "essentials/navigation"
                        ]
                    },
                    {
                        "group": "Writing content",
                        "pages": [
                            "essentials/markdown",
                            "essentials/code",
                            "essentials/images",
                            "essentials/reusable-snippets"
                        ]
                    },
                    {
                        "group": "AI tools",
                        "pages": [
                            "ai-tools/cursor",
                            "ai-tools/claude-code",
                            "ai-tools/windsurf"
                        ]
                    }
                ]
            },
            {
                "tab": "API reference",
                "groups": [
                    {
                        "group": "Getting Started",
                        "pages": ["api-reference/introduction"]
                    },

                    {
                        "group": "Payments API",
                        "pages": [
                            "api-reference/endpoint/create-payment",
                            "api-reference/endpoint/list-payments",
                            "api-reference/endpoint/get-payment",
                            "api-reference/endpoint/get-payment-by-reference"
                        ]
                    },
                    {
                        "group": "Webhooks",
                        "pages": [
                            "api-reference/endpoint/webhooks",
                            "api-reference/endpoint/verify-signature"
                        ]
                    }
                ]
            }
        ],
        "global": {
            "anchors": []
        }
    },
    "logo": {
        "light": "/logo/light.svg",
        "dark": "/logo/dark.svg"
    },
    "navbar": {
        "links": [
            {
                "label": "Support",
                "href": "mailto:hello@creptapay.com"
            }
        ],
        "primary": {
            "type": "button",
            "label": "Dashboard",
            "href": "https://app.creptapay.com"
        }
    },
    "contextual": {
        "options": [
            "copy",
            "view",
            "chatgpt",
            "claude",
            "perplexity",
            "mcp",
            "cursor",
            "vscode"
        ]
    },
    "footer": {
        "socials": {
            "x": "https://x.com/creptapay",
            "github": "https://github.com/creptapay",
            "linkedin": "https://linkedin.com/company/creptapay"
        }
    }
}
