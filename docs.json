{
    "$schema": "https://mintlify.com/docs.json",
    "theme": "mint",
    "name": "CreptaPay",
    "appearance": {
        "default": "dark",
        "strict": true
    },
    "colors": {
        "primary": "#09CCDD",
        "light": "#0CDDFF",
        "dark": "#008FA1"
    },
    "favicon": "/favicon.svg",
    "navigation": {
        "tabs": [
            {
                "tab": "Guides",
                "groups": [
                    {
                        "group": "Getting Started",
                        "pages": ["guides/introduction"]
                    },
                    {
                        "group": "Webhooks",
                        "pages": [
                            "guides/webhooks",
                            "guides/verify-signature"
                        ]
                    }
                ]
            },
            {
                "tab": "API reference",
                "groups": [
                    {
                        "group": "Payments",
                        "pages": [
                            "api-reference/endpoint/create-payment",
                            "api-reference/endpoint/list-payments",
                            "api-reference/endpoint/get-payment",
                            "api-reference/endpoint/get-payment-by-reference"
                        ]
                    },
                    {
                        "group": "Customers",
                        "pages": [
                            "api-reference/endpoint/create-customer",
                            "api-reference/endpoint/list-customers",
                            "api-reference/endpoint/get-customer",
                            "api-reference/endpoint/update-customer",
                            "api-reference/endpoint/delete-customer"
                        ]
                    }
                ]
            }
        ],
        "global": {
            "anchors": []
        }
    },
    "logo": {
        "light": "/logo/light.svg",
        "dark": "/logo/dark.svg"
    },
    "navbar": {
        "links": [
            {
                "label": "Support",
                "href": "mailto:hello@creptapay.com"
            }
        ],
        "primary": {
            "type": "button",
            "label": "Dashboard",
            "href": "https://app.creptapay.com"
        }
    },
    "contextual": {
        "options": [
            "copy",
            "view",
            "chatgpt",
            "claude",
            "perplexity",
            "mcp",
            "cursor",
            "vscode"
        ]
    },
    "footer": {
        "socials": {
            "x": "https://x.com/creptapay",
            "github": "https://github.com/creptapay",
            "linkedin": "https://linkedin.com/company/creptapay"
        }
    }
}
